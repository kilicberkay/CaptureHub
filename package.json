{
  "name": "capturehub",
  "version": "1.2.4",
  "private": true,
  "description": "Screenshot Chrome extension: visible area, full page, region and element capture with an annotation editor.",
  "license": "MIT",
  "scripts": {
    "check": "node tools/check-syntax.js",
    "test": "node tools/run-tests.js",
    "test:quick": "node tools/run-tests.js --no-e2e",
    "test:e2e": "node --test --test-timeout=400000 tests/e2e/*.test.mjs",
    "build": "node tools/build.js",
    "images": "node tools/make-store-assets.mjs && node tools/make-readme-shots.mjs",
    "demo": "node tools/make-demo.mjs en && node tools/make-demo.mjs tr"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kilicberkay/CaptureHub.git"
  },
  "homepage": "https://github.com/kilicberkay/CaptureHub#readme",
  "bugs": {
    "url": "https://github.com/kilicberkay/CaptureHub/issues"
  },
  "author": "Berkay Kılıç"
}
